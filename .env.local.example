# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Chemistry microservice
# CHEMISTRY_SERVICE_URL is the local tool-service base URL; CHEMISTRY_SERVICE_TOKEN is its optional shared token.
# The generated local index path is services/chemistry/data/solvent-evidence/solvent-evidence.sqlite.
# Rebuild it with:
# python3 scripts/chemistry/build_solvent_evidence_index.py --raw services/chemistry/data/solvent-evidence/raw --manifests services/chemistry/data/solvent-evidence/manifests --output services/chemistry/data/solvent-evidence/solvent-evidence.sqlite
# Harvest PubChem GHS snapshots explicitly (never from a chat request):
# python3 scripts/chemistry/harvest_solvent_hazards.py --database services/chemistry/data/solvent-evidence/solvent-evidence.sqlite --snapshots services/chemistry/data/solvent-evidence/raw/pubchem-ghs --interval-seconds 2
CHEMISTRY_SERVICE_URL=http://localhost:8000
CHEMISTRY_SERVICE_TOKEN=

# Open-weights chat model (OpenRouter or a loopback OpenAI-compatible endpoint)
CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=qwen/qwen3.6-35b-a3b
CHAT_LLM_ALLOWED_MODELS=qwen/qwen3.6-35b-a3b
CHAT_LLM_ALLOWED_BASE_URLS=https://openrouter.ai/api/v1

# OpenAI (used for literature search embeddings only)
OPENAI_API_KEY=
